{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "root": true,
    "extends": ["@flippo-software/biome/base", "@flippo-software/biome/react"],
    "files": {
        "includes": ["!**/node_modules", "!**/dist", "!**/.download-*"]
    },
    "overrides": [
        {
            "includes": ["tools/**", "**/*.config.ts"],
            "linter": {
                "rules": {
                    "correctness": { "noNodejsModules": "off" },
                    "style": { "noProcessEnv": "off", "useFilenamingConvention": "off" },
                    "suspicious": { "noConsole": "off" },
                    "performance": { "useTopLevelRegex": "off" }
                }
            }
        },
        {
            "includes": ["**/*.config.ts"],
            "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
        },
        {
            "includes": ["packages/react-icons/src/**", "packages/svg-icons/icons/**"],
            "linter": { "enabled": false }
        }
    ]
}

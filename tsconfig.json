{
    "extends": "@flippo/tsconfig",
    "compilerOptions": {
        "composite": false,
        "jsx": "react-jsx",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],

        "types": ["node", "react", "react-dom"],
        "allowJs": true,
        "paths": {
            "*": ["./*"]
        }
    },
    "include": ["lib/**/*.ts", "scripts/**/*.js", "lib/**/*.tsx", "lib/**/*.jsx", "./*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
